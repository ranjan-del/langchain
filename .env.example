# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NOTE: every example in this repo runs fully OFFLINE with NO .env at all.
# Each script falls back to a deterministic local implementation, so no key is
# required to run the examples or the test suite. The variables below are
# OPTIONAL and only matter if you extend an example to call a hosted model.

# OpenAI (optional) - used only if you wire a real OpenAI model into an example.
OPENAI_API_KEY=

# Anthropic Claude (optional) - used only if you wire a real Anthropic model in.
ANTHROPIC_API_KEY=
